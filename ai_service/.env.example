# Configure only in server-side Vercel environment settings; never NEXT_PUBLIC_*.
AI_DEVICE=cpu
AI_STATE_BACKEND=redis
AI_REDIS_URL=rediss://USER:PASSWORD@HOST:PORT/0
AI_STATE_NAMESPACE=signhearing:ai:v1:
AI_TOKEN_SECRET=REUSE_THE_EXISTING_PRIVATE_SIGNING_KEY
AI_ALLOWED_ORIGINS=["https://test-signhearing.vercel.app"]
AI_BLOB_ORIGIN=https://STOREID.private.blob.vercel-storage.com
BLOB_READ_WRITE_TOKEN=PRIVATE_STORE_READ_WRITE_TOKEN
# Frontend only, for orphan-upload cleanup. Requires a supported five-minute Cron.
CRON_SECRET=CONFIGURE_A_SEPARATE_RANDOM_SECRET
# SIFORMER_SERVICE_URL is injected by the binding; do not set it manually.
# MP_PYTHON and CUDA_VISIBLE_DEVICES are already set in the image.
